  <property name="styleSheet">
   <string notr="true">QWidget {
    background-color: #1E2127;
    color: #EFEFEF;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
}
QGroupBox {
    border: 1px solid #3D4452;
    border-radius: 6px;
    margin-top: 16px;
    padding-top: 4px;
    color: #ABB2BF;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
}
QPushButton {
    background-color: #282C34;
    color: #EFEFEF;
    border: 1px solid #3D4452;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
}
QPushButton:hover {
    background-color: #353A47;
    border-color: #61AFEF;
}
QPushButton:pressed {
    background-color: #23272E;
}
QPushButton:disabled {
    color: #5C6370;
    background-color: #23272E;
    border-color: #2A2F3A;
}
QPushButton#btn_estop {
    background-color: #E06C75;
    color: white;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#btn_estop:hover {
    background-color: #C0505E;
}
QPushButton#btn_estop:disabled {
    background-color: #5A3038;
    color: #885060;
}
QPushButton#btn_on {
    background-color: #56B870;
    color: #1A1D22;
    font-weight: bold;
}
QPushButton#btn_on:hover {
    background-color: #45A060;
}
QPushButton#btn_on:disabled {
    background-color: #2A4035;
    color: #5C6370;
}
QLineEdit {
    background-color: #282C34;
    color: #EFEFEF;
    border: 1px solid #3D4452;
    border-radius: 4px;
    padding: 4px 8px;
}
QLineEdit:focus {
    border-color: #61AFEF;
}
QPlainTextEdit {
    background-color: #151820;
    color: #7E8898;
    border: 1px solid #3D4452;
    border-radius: 4px;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 11px;
}
QSpinBox {
    background-color: #282C34;
    color: #EFEFEF;
    border: 1px solid #3D4452;
    border-radius: 4px;
    padding: 3px 6px;
}
QSpinBox:disabled {
    color: #5C6370;
    border-color: #2A2F3A;
}
QSpinBox::up-button, QSpinBox::down-button {
    background: #3D4452;
    border: none;
    width: 16px;
}
QSlider::groove:horizontal {
    background: #3D4452;
    height: 4px;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #61AFEF;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #61AFEF;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal:disabled {
    background: #3D4452;
}
QSlider::handle:horizontal:disabled {
    background: #5C6370;
}
QMenuBar {
    background-color: #181B22;
    color: #EFEFEF;
    border-bottom: 1px solid #3D4452;
    padding: 2px 8px;
    font-size: 13px;
}
QMenuBar::item:selected {
    background-color: #282C34;
    border-radius: 4px;
}
QMenu {
    background-color: #282C34;
    color: #EFEFEF;
    border: 1px solid #3D4452;
    padding: 4px 0;
}
QMenu::item {
    padding: 6px 20px 6px 12px;
}
QMenu::item:selected {
    background-color: #353A47;
}</string>
