 <customwidgets>
  <customwidget>
   <class>SensorCard</class>
   <extends>QFrame</extends>
   <header>ui.widgets</header>
  </customwidget>
  <customwidget>
   <class>ActuatorRow</class>
   <extends>QWidget</extends>
