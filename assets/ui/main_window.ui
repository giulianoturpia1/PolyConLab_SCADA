            <property name="title"><string>Estado del Sistema</string></property>
            <layout class="QVBoxLayout" name="vbox_state">
             <item>
              <widget class="QLabel" name="lbl_state">
               <property name="text"><string>--</string></property>
               <property name="alignment"><set>Qt::AlignCenter</set></property>
               <property name="styleSheet"><string notr="true">color: #5C6370; background: #282C34; border: 2px solid #5C6370; border-radius: 6px; font-size: 18px; font-weight: bold; padding: 14px 8px;</string></property>
