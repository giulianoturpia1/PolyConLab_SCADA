  </customwidget>
 </customwidgets>
 <connections>
  <connection>
   <sender>heater_slider</sender>
   <signal>valueChanged(int)</signal>
   <receiver>heater_spinbox</receiver>
   <slot>setValue(int)</slot>
   <hints>
    <hint type="sourcelabel"><x>-1</x><y>-1</y></hint>
    <hint type="destinationlabel"><x>-1</x><y>-1</y></hint>
   </hints>
  </connection>
  <connection>
   <sender>heater_spinbox</sender>
   <signal>valueChanged(int)</signal>
   <receiver>heater_slider</receiver>
   <slot>setValue(int)</slot>
   <hints>
    <hint type="sourcelabel"><x>-1</x><y>-1</y></hint>
    <hint type="destinationlabel"><x>-1</x><y>-1</y></hint>
   </hints>
  </connection>
 </connections>
</ui>
